{
  "manifest_version": 3,
  "name": "Tab Resource Saver & Sleep Manager",
  "version": "2.0.0",
  "description": "Monitors tabs, prevents memory hogging, allows auto-unloading up to 7 days, domain/tab whitelisting, and running tab indicators.",
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    },
    "default_title": "Tab Resource Saver"
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "tab-resource-saver-v2@firefox.addon",
      "strict_min_version": "109.0"
    }
  }
}